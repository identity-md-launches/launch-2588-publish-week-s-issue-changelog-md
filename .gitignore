# Submission path budget: artifacts/ at most 6.5 MiB in total:
# issue 003 keeps its 3.75 MiB allowance (2.5 MiB JSON, 1.25 MiB images);
# issue 004 has 2.75 MiB (2 MiB JSON, 0.75 MiB images). Only the exact
# files below are allowed. All other submitted paths share 1.5 MiB.
# The complete submission must remain within 8 MiB (8,388,608 bytes).
!/artifacts/
/artifacts/*
!/artifacts/003-counts.json
!/artifacts/003-story-evidence.json
!/artifacts/003-interaction-results.json
!/artifacts/003-render-review.json
!/artifacts/003-taste.json
!/artifacts/003-screenshots/
/artifacts/003-screenshots/*
!/artifacts/003-screenshots/mobile-first-screen.png
!/artifacts/003-screenshots/desktop.png
!/artifacts/003-screenshots/glossary.png
!/artifacts/003-screenshots/keyboard-focus.png
!/artifacts/004-counts.json
!/artifacts/004-story-evidence.json
!/artifacts/004-interaction-results.json
!/artifacts/004-render-review.json
!/artifacts/004-taste.json
!/artifacts/004-screenshots/
/artifacts/004-screenshots/*
!/artifacts/004-screenshots/mobile-first-screen.jpg
!/artifacts/004-screenshots/desktop.jpg
!/artifacts/004-screenshots/glossary.jpg
!/artifacts/004-screenshots/keyboard-focus.jpg

# Development dependencies and caches are never submission assets, at any depth.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.vite/
.cache/
